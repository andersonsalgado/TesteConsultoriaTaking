@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="form-card">
                <h2 class="mb-3">Bem-vindo de volta</h2>
                <p class="text-muted mb-4">Entre para acessar suas funcionalidades exclusivas e gerenciar os treinos da sua academia.</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" placeholder="email@exemplo.com" />
                        <span asp-validation-for="UserName" class="text-warning small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" placeholder="Sua senha" />
                            <span class="input-group-text bg-transparent border-start-0"><i class="fa-solid fa-lock text-warning"></i></span>
                        </div>
                        <span asp-validation-for="Password" class="text-warning small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <div asp-validation-summary="All" class="text-warning mb-3"></div>
                    <button type="submit" class="btn btn-gradient w-100">Entrar</button>
                </form>
                <hr class="my-4" />
                <p class="text-muted mb-0">Ainda não tem uma conta? <a href="@Url.Action("Register", "Account")" class="text-warning text-decoration-none">Crie agora mesmo</a>.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
