@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="form-card">
                    <div class="text-center mb-4">
                        <span class="badge badge-custom text-uppercase mb-3">Bem-vindo de volta</span>
                        <h2 class="section-title fs-2">Acesse sua conta</h2>
                        <p class="text-secondary">Gerencie treinos, clientes e métricas em um só lugar.</p>
                    </div>
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>
                        <div class="mb-3">
                            <label class="input-label" asp-for="Email"></label>
                            <input class="form-control" asp-for="Email" placeholder="nome@empresa.com" />
                            <span class="text-warning small" asp-validation-for="Email"></span>
                        </div>
                        <div class="mb-3">
                            <label class="input-label" asp-for="Password"></label>
                            <input class="form-control" asp-for="Password" placeholder="Sua senha" />
                            <span class="text-warning small" asp-validation-for="Password"></span>
                        </div>
                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label" asp-for="RememberMe"></label>
                        </div>
                        <button type="submit" class="btn btn-gradient w-100 btn-icon mb-3">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Entrar
                        </button>
                        <div class="text-center text-secondary">
                            Ainda não possui conta?
                            <a asp-action="Register" class="text-decoration-none">Crie agora mesmo</a>.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
