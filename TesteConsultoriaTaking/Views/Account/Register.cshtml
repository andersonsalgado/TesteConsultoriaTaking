@model RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-card">
                    <div class="text-center mb-4">
                        <span class="badge badge-custom text-uppercase mb-3">Comece agora</span>
                        <h2 class="section-title fs-2">Monte treinos inesquecíveis</h2>
                        <p class="text-secondary">Cadastre clientes, crie treinos e acompanhe resultados com uma experiência visual impactante.</p>
                    </div>
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>
                        <div class="mb-3">
                            <label class="input-label" asp-for="FullName"></label>
                            <input class="form-control" asp-for="FullName" placeholder="Seu nome completo" />
                            <span class="text-warning small" asp-validation-for="FullName"></span>
                        </div>
                        <div class="mb-3">
                            <label class="input-label" asp-for="Email"></label>
                            <input class="form-control" asp-for="Email" placeholder="nome@academia.com" />
                            <span class="text-warning small" asp-validation-for="Email"></span>
                        </div>
                        <div class="mb-3">
                            <label class="input-label" asp-for="Password"></label>
                            <input class="form-control" asp-for="Password" placeholder="Crie uma senha" />
                            <span class="text-warning small" asp-validation-for="Password"></span>
                        </div>
                        <div class="mb-4">
                            <label class="input-label" asp-for="ConfirmPassword"></label>
                            <input class="form-control" asp-for="ConfirmPassword" placeholder="Repita a senha" />
                            <span class="text-warning small" asp-validation-for="ConfirmPassword"></span>
                        </div>
                        <button type="submit" class="btn btn-gradient w-100 btn-icon mb-3">
                            <i class="bi bi-stars"></i>
                            Criar minha conta
                        </button>
                        <div class="text-center text-secondary">
                            Já possui login?
                            <a asp-action="Login" class="text-decoration-none">Entrar</a>.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
