@model TesteConsultoriaTaking.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
}

<section class="py-5">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="form-elevated">
                    <div class="text-center mb-4">
                        <span class="gradient-icon mb-3"><i class="bi bi-person-heart"></i></span>
                        <h2 class="fw-bold">Crie sua conta TreinoX</h2>
                        <p class="text-muted">Configure sua academia ou atendimento personalizado em poucos minutos.</p>
                    </div>
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="voce@treinox.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-shield-lock-fill"></i></span>
                                    <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-shield-check"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repita a senha" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" value="true" id="termsCheck" required>
                            <label class="form-check-label" for="termsCheck">
                                Concordo com os <a href="#" class="text-decoration-none">termos de uso</a> e a <a href="#" class="text-decoration-none">política de privacidade</a>.
                            </label>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-gradient btn-lg">Criar conta</button>
                        </div>
                        <div class="text-center mt-4">
                            <p class="mb-0 text-muted">Já tem acesso? <a class="fw-semibold text-decoration-none" href="@Url.Action("Login", "Account")">Entre agora</a>.</p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
