@{
    ViewData["Title"] = "Novo Cliente";
}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-8">
                <div class="card-blur p-4">
                    <span class="badge badge-custom text-uppercase mb-2">Cadastro</span>
                    <h2 class="section-title fs-2 mb-0">Adicionar novo aluno</h2>
                    <p class="text-secondary mb-0">Preencha as informações e acompanhe o progresso desse cliente pelo painel principal.</p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-card">
                    <form id="formCriar" class="row g-3">
                        <div class="col-12">
                            <label class="input-label" for="nome">Nome completo</label>
                            <input id="nome" name="nome" class="form-control" maxlength="100" placeholder="Nome do aluno" required />
                        </div>
                        <div class="col-12">
                            <label class="input-label" for="idade">Idade</label>
                            <input id="idade" name="idade" type="number" min="0" class="form-control" placeholder="Idade" required />
                        </div>
                        <div class="col-12">
                            <div id="mensagemErro" class="alert alert-warning d-none"></div>
                        </div>
                        <div class="col-12 d-flex gap-3">
                            <button type="submit" class="btn btn-gradient btn-icon flex-grow-1">
                                <i class="bi bi-check-circle-fill"></i>
                                Salvar cliente
                            </button>
                            <a href="/clientes" class="btn btn-outline-light btn-icon">
                                <i class="bi bi-arrow-left"></i>
                                Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        const formCriar = document.querySelector('#formCriar');
        const mensagemErro = document.querySelector('#mensagemErro');

        function exibirErro(erros) {
            if (!erros) {
                mensagemErro.classList.add('d-none');
                mensagemErro.innerHTML = '';
                return;
            }

            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
        }

        formCriar.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            exibirErro();

            const payload = {
                nome: formCriar.nome.value.trim(),
                idade: Number.parseInt(formCriar.idade.value, 10)
            };

            try {
                const resposta = await fetch('/api/cliente/adicionar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (resposta.status === 401) {
                    const retorno = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = `/Account/Login?returnUrl=${retorno}`;
                    return;
                }

                if (!resposta.ok) {
                    const conteudo = await resposta.json().catch(() => null);
                    const erros = conteudo?.listaErros ?? conteudo?.ListaErros ?? ['Não foi possível salvar o cliente.'];
                    throw erros;
                }

                window.location.href = '/clientes';
            } catch (erro) {
                exibirErro(erro);
            }
        });
    </script>
}
