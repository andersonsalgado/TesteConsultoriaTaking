@{
    ViewData["Title"] = "Clientes";
}
<section class="py-5">
    <div class="container">
        <div class="row g-4 align-items-center mb-4">
            <div class="col-lg-7">
                <div class="card-blur p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge badge-custom text-uppercase">Painel de clientes</span>
                            <h2 class="section-title fs-2 mb-0">Gerencie seus alunos com elegância</h2>
                        </div>
                        <i class="bi bi-people-fill display-5 text-warning d-none d-lg-block"></i>
                    </div>
                    <p class="text-secondary mb-0">Crie cadastros, atualize dados e visualize cada aluno em um fluxo intuitivo. Utilize o botão abaixo para adicionar novos clientes.</p>
                </div>
            </div>
            <div class="col-lg-5 text-lg-end">
                <a class="btn btn-gradient btn-icon" href="/clientes/criar">
                    <i class="bi bi-person-plus-fill"></i>
                    Novo cliente
                </a>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="feature-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="mb-0">Lista de clientes</h3>
                        <span class="badge rounded-pill bg-light text-dark" id="totalClientes">0 ativos</span>
                    </div>
                    <div id="erroCarregamento" class="alert alert-warning d-none" role="alert"></div>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle" id="tabelaClientes">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th class="text-center">Idade</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="3" class="text-center py-4">
                                        <div class="spinner-border text-warning" role="status">
                                            <span class="visually-hidden">Carregando...</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        const tabelaClientes = document.querySelector('#tabelaClientes tbody');
        const erroCarregamento = document.querySelector('#erroCarregamento');
        const totalClientes = document.querySelector('#totalClientes');

        function mostrarErro(mensagem) {
            erroCarregamento.textContent = mensagem;
            erroCarregamento.classList.remove('d-none');
        }

        function limparErro() {
            erroCarregamento.classList.add('d-none');
            erroCarregamento.textContent = '';
        }

        function criarLinha(cliente) {
            const tr = document.createElement('tr');
            const id = cliente.id ?? cliente.Id;
            tr.innerHTML = `
                <td class="fw-semibold">${cliente.nome ?? cliente.Nome}</td>
                <td class="text-center"><span class="badge badge-status bg-dark-subtle text-light">${cliente.idade ?? cliente.Idade} anos</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-light btn-icon me-2" href="/clientes/detalhes/${id}"><i class="bi bi-eye-fill"></i> Detalhes</a>
                    <a class="btn btn-sm btn-outline-warning btn-icon me-2" href="/clientes/editar/${id}"><i class="bi bi-pencil-square"></i> Editar</a>
                    <a class="btn btn-sm btn-outline-danger btn-icon" href="/clientes/remover/${id}"><i class="bi bi-trash-fill"></i> Remover</a>
                </td>`;
            return tr;
        }

        async function carregarClientes() {
            limparErro();
            tabelaClientes.innerHTML = `
                <tr>
                    <td colspan="3" class="text-center py-4">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                    </td>
                </tr>`;
            try {
                const resposta = await fetch('/api/cliente/listarTodos');
                if (resposta.status === 401) {
                    const retorno = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = `/Account/Login?returnUrl=${retorno}`;
                    return;
                }
                if (!resposta.ok) {
                    throw new Error('Não foi possível carregar os clientes.');
                }
                const dados = await resposta.json();
                const clientes = dados.listaEntidade ?? dados.ListaEntidade ?? [];

                if (!Array.isArray(clientes) || clientes.length === 0) {
                    tabelaClientes.innerHTML = '<tr><td colspan="3" class="text-center py-4">Nenhum cliente cadastrado ainda.</td></tr>';
                    totalClientes.textContent = '0 ativos';
                    return;
                }

                tabelaClientes.innerHTML = '';
                clientes.forEach(cliente => tabelaClientes.appendChild(criarLinha(cliente)));
                totalClientes.textContent = `${clientes.length} ativo${clientes.length > 1 ? 's' : ''}`;
            } catch (erro) {
                tabelaClientes.innerHTML = '<tr><td colspan="3" class="text-center py-4">Não foi possível exibir os dados.</td></tr>';
                mostrarErro(erro.message);
            }
        }

        document.addEventListener('DOMContentLoaded', carregarClientes);
    </script>
}
