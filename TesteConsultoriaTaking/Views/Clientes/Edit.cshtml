@{
    ViewData["Title"] = "Editar Cliente";
    var clienteId = ViewData["ClienteId"]?.ToString();
}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-8">
                <div class="card-blur p-4">
                    <span class="badge badge-custom text-uppercase mb-2">Atualização</span>
                    <h2 class="section-title fs-2 mb-0">Editar dados do aluno</h2>
                    <p class="text-secondary mb-0">Ajuste as informações para manter o histórico sempre alinhado aos objetivos do seu cliente.</p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-card">
                    <form id="formEditar" class="row g-3">
                        <div class="col-12">
                            <label class="input-label" for="nome">Nome completo</label>
                            <input id="nome" name="nome" class="form-control" maxlength="100" required />
                        </div>
                        <div class="col-12">
                            <label class="input-label" for="idade">Idade</label>
                            <input id="idade" name="idade" type="number" min="0" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <div id="mensagemErro" class="alert alert-warning d-none"></div>
                        </div>
                        <div class="col-12 d-flex gap-3">
                            <button type="submit" class="btn btn-gradient btn-icon flex-grow-1">
                                <i class="bi bi-save-fill"></i>
                                Salvar alterações
                            </button>
                            <a href="/clientes" class="btn btn-outline-light btn-icon">
                                <i class="bi bi-arrow-left"></i>
                                Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        const clienteId = '@clienteId';
        const formEditar = document.querySelector('#formEditar');
        const mensagemErro = document.querySelector('#mensagemErro');

        function exibirErro(erros) {
            if (!erros) {
                mensagemErro.classList.add('d-none');
                mensagemErro.innerHTML = '';
                return;
            }

            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
        }

        async function carregarCliente() {
            try {
                const resposta = await fetch(`/api/cliente/buscarcliente/${clienteId}`);
                if (resposta.status === 401) {
                    const retorno = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = `/Account/Login?returnUrl=${retorno}`;
                    return;
                }
                if (!resposta.ok) {
                    throw ['Não foi possível carregar o cliente.'];
                }
                const dados = await resposta.json();
                const cliente = dados.entidade ?? dados.Entidade;
                if (!cliente) {
                    throw ['Cliente não encontrado.'];
                }

                formEditar.nome.value = cliente.nome ?? cliente.Nome ?? '';
                formEditar.idade.value = cliente.idade ?? cliente.Idade ?? '';
            } catch (erro) {
                exibirErro(erro);
            }
        }

        formEditar.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            exibirErro();

            const payload = {
                id: clienteId,
                nome: formEditar.nome.value.trim(),
                idade: Number.parseInt(formEditar.idade.value, 10)
            };

            try {
                const resposta = await fetch(`/api/cliente/atualizar/${clienteId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (resposta.status === 401) {
                    const retorno = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = `/Account/Login?returnUrl=${retorno}`;
                    return;
                }

                if (!resposta.ok) {
                    const conteudo = await resposta.json().catch(() => null);
                    const erros = conteudo?.listaErros ?? conteudo?.ListaErros ?? ['Não foi possível atualizar o cliente.'];
                    throw erros;
                }

                window.location.href = '/clientes';
            } catch (erro) {
                exibirErro(erro);
            }
        });

        document.addEventListener('DOMContentLoaded', carregarCliente);
    </script>
}
