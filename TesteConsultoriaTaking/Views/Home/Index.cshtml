@{
    ViewData["Title"] = "Bem-vindo";
}

<section id="home" class="hero-section text-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge badge-soft text-uppercase mb-3"><i class="bi bi-lightning-fill me-2"></i>Alta performance</span>
                <h1>Potencialize seus treinos com planos inteligentes para cada objetivo.</h1>
                <p class="lead">Crie rotinas personalizadas, acompanhe a evolução da sua equipe e inspire alunos com uma experiência digital imersiva.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-gradient" asp-area="Identity" asp-page="@(User.Identity.IsAuthenticated ? "/Account/Manage/Index" : "/Account/Register")">
                        <i class="bi bi-play-circle-fill me-2"></i>@(User.Identity.IsAuthenticated ? "Gerenciar Conta" : "Começar agora")
                    </a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a class="btn btn-outline-light" href="/clientes"><i class="bi bi-people-fill me-2"></i>Clientes cadastrados</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-person-check-fill me-2"></i>Entrar</a>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-card">
                    <h5 class="text-uppercase text-warning mb-3">Treino do dia</h5>
                    <p class="fw-semibold mb-4">Sprint explosivo • 45 minutos</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-3"><i class="bi bi-check2-circle me-2 text-warning"></i>Aquecimento dinâmico funcional</li>
                        <li class="mb-3"><i class="bi bi-check2-circle me-2 text-warning"></i>Circuito HIIT com kettlebell</li>
                        <li class="mb-3"><i class="bi bi-check2-circle me-2 text-warning"></i>Core intensivo com prancha instável</li>
                        <li><i class="bi bi-check2-circle me-2 text-warning"></i>Alongamento ativo guiado</li>
                    </ul>
                    <p class="mb-0 small text-white-50">Atualizado diariamente com base no desempenho dos alunos. Visualize e ajuste em segundos.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="funcionalidades" class="section-padding bg-white">
    <div class="container">
        <div class="row justify-content-between align-items-center mb-5">
            <div class="col-lg-6">
                <h2 class="section-title">Tudo o que a sua academia precisa em um só lugar</h2>
            </div>
            <div class="col-lg-5">
                <p class="section-subtitle">Planeje treinos, organize alunos e acompanhe resultados com dashboards vibrantes, totalmente responsivos e preparados para qualquer dispositivo.</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="gradient-card h-100">
                    <div class="icon-pill"><i class="bi bi-calendar-week"></i></div>
                    <h5 class="fw-bold">Agenda de treinos dinâmica</h5>
                    <p>Monte planos semanais com drag and drop, configure lembretes automáticos e sincronize tudo com os alunos.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="gradient-card h-100">
                    <div class="icon-pill"><i class="bi bi-graph-up-arrow"></i></div>
                    <h5 class="fw-bold">Relatórios de performance</h5>
                    <p>Acompanhe métricas de evolução, frequência e intensidade de treino com gráficos envolventes em tempo real.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="gradient-card h-100">
                    <div class="icon-pill"><i class="bi bi-people"></i></div>
                    <h5 class="fw-bold">Gestão de alunos simplificada</h5>
                    <p>Cadastre clientes, personalize fichas e mantenha histórico de treinos em um só lugar com acesso seguro.</p>
                </div>
            </div>
        </div>
        @if (User.Identity.IsAuthenticated)
        {
            <div class="text-center mt-5">
                <a class="btn btn-gradient" href="/clientes"><i class="bi bi-clipboard2-data me-2"></i>Abrir cadastro de clientes</a>
            </div>
        }
    </div>
</section>

<section id="preco" class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Planos flexíveis para toda estrutura</h2>
            <p class="section-subtitle mx-auto">Escolha o pacote perfeito para sua academia, seja para treinos personalizados ou grandes equipes.</p>
        </div>
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4">
                <div class="pricing-card h-100">
                    <h5 class="fw-bold mb-3">Essencial</h5>
                    <p class="display-5 fw-bold text-dark">R$79<span class="fs-5">/mês</span></p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Até 50 alunos</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Biblioteca de exercícios</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Dashboard básico</li>
                    </ul>
                    <a class="btn btn-outline-dark w-100" asp-area="Identity" asp-page="/Account/Register">Testar agora</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="pricing-card highlight text-center h-100">
                    <span class="badge badge-soft bg-warning text-dark mb-3">Mais Popular</span>
                    <h5 class="fw-bold mb-3">Profissional</h5>
                    <p class="display-5 fw-bold">R$149<span class="fs-5">/mês</span></p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Clientes ilimitados</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Automação de treinos</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Relatórios avançados</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Suporte prioritário</li>
                    </ul>
                    <a class="btn btn-gradient w-100" asp-area="Identity" asp-page="/Account/Register">Quero este plano</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="pricing-card h-100">
                    <h5 class="fw-bold mb-3">Elite Corporativo</h5>
                    <p class="display-5 fw-bold text-dark">Sob consulta</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Unidades ilimitadas</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Integração com biometria</li>
                        <li class="mb-3"><i class="bi bi-check2-circle text-warning me-2"></i>Suporte 24/7 dedicado</li>
                    </ul>
                    <a class="btn btn-outline-dark w-100" href="#contato">Falar com consultor</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="relatos" class="section-padding bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Resultados reais de quem já treina com a gente</h2>
            <p class="section-subtitle mx-auto">Histórias de transformação de alunos e treinadores que encontraram performance e motivação nas nossas ferramentas.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card h-100">
                    <div class="d-flex align-items-center mb-3">
                        <img class="rounded-circle me-3" src="https://images.unsplash.com/photo-1541534401786-2077eed87a75?auto=format&fit=crop&w=120&q=80" alt="Aluna" width="54" height="54" />
                        <div>
                            <h6 class="mb-0 fw-bold">Ana Ribeiro</h6>
                            <small class="text-muted">Atleta de Cross Training</small>
                        </div>
                    </div>
                    <p class="mb-0">“Os treinos personalizados e a visualização de metas tornaram minha evolução muito mais clara. Já conquistei 2 pódios este ano!”</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card h-100">
                    <div class="d-flex align-items-center mb-3">
                        <img class="rounded-circle me-3" src="https://images.unsplash.com/photo-1546484959-fcc74af210cc?auto=format&fit=crop&w=120&q=80" alt="Personal" width="54" height="54" />
                        <div>
                            <h6 class="mb-0 fw-bold">Diego Martins</h6>
                            <small class="text-muted">Personal Trainer</small>
                        </div>
                    </div>
                    <p class="mb-0">“Organizo meus alunos com facilidade e consigo dar feedback preciso em cada sessão. A fidelização aumentou muito.”</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card h-100">
                    <div class="d-flex align-items-center mb-3">
                        <img class="rounded-circle me-3" src="https://images.unsplash.com/photo-1558611848-73f7eb4001a1?auto=format&fit=crop&w=120&q=80" alt="Gestora" width="54" height="54" />
                        <div>
                            <h6 class="mb-0 fw-bold">Larissa Couto</h6>
                            <small class="text-muted">Gestora de Academia</small>
                        </div>
                    </div>
                    <p class="mb-0">“Acompanhar métricas de frequência e engajamento ficou intuitivo. Conseguimos criar desafios mensais que motivam todos.”</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="faq" class="section-padding">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">Perguntas frequentes</h2>
                <p class="section-subtitle">Tudo o que você precisa saber antes de transformar a rotina da sua academia.</p>
            </div>
        </div>
        <div class="accordion" id="faqAccordion">
            <div class="accordion-item faq-item">
                <h2 class="accordion-header" id="faqOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Posso migrar meus alunos atuais para o sistema?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="faqOne" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Sim! Você pode importar listas de alunos e treinos a partir de planilhas. Nossa equipe de suporte auxilia em todo o processo.
                    </div>
                </div>
            </div>
            <div class="accordion-item faq-item">
                <h2 class="accordion-header" id="faqTwo">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        Existe aplicativo para os alunos?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="faqTwo" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Sim, os alunos acessam treinos, vídeos e check-ins pelo aplicativo responsivo, disponível em qualquer navegador mobile.
                    </div>
                </div>
            </div>
            <div class="accordion-item faq-item">
                <h2 class="accordion-header" id="faqThree">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        Como funciona o suporte técnico?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="faqThree" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Contamos com chat humanizado, central de ajuda e onboarding guiado. No plano Elite, um especialista acompanha sua operação.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contato" class="section-padding bg-white">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="contact-card h-100">
                    <h3 class="fw-bold mb-4">Pronto para elevar o nível da sua academia?</h3>
                    <p class="mb-4">Nossa equipe está preparada para montar um plano sob medida para sua operação. Envie uma mensagem e retornaremos em até 24 horas úteis.</p>
                    <form class="row g-3">
                        <div class="col-md-6">
                            <label for="contatoNome" class="form-label">Nome</label>
                            <input type="text" class="form-control" id="contatoNome" placeholder="Seu nome" />
                        </div>
                        <div class="col-md-6">
                            <label for="contatoEmail" class="form-label">E-mail</label>
                            <input type="email" class="form-control" id="contatoEmail" placeholder="voce@academia.com" />
                        </div>
                        <div class="col-12">
                            <label for="contatoMensagem" class="form-label">Mensagem</label>
                            <textarea class="form-control" id="contatoMensagem" rows="4" placeholder="Conte-nos sobre sua necessidade"></textarea>
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn btn-gradient"><i class="bi bi-send-fill me-2"></i>Enviar mensagem</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-6">
                <img class="img-fluid rounded-3 shadow" src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1400&q=80" alt="Equipe treinando" />
            </div>
        </div>
    </div>
</section>
