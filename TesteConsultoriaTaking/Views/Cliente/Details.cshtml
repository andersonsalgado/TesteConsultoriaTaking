@{
    ViewData["Title"] = "Detalhes do Cliente";
    var clienteId = ViewData["ClienteId"]?.ToString();
}

<section class="py-5">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div id="mensagemErro" class="alert alert-danger d-none"></div>
                <div class="card border-0 shadow-sm" id="cardDetalhes" style="display:none;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <span class="gradient-icon me-3"><i class="bi bi-person-bounding-box"></i></span>
                            <div>
                                <h2 class="fw-bold mb-0" id="detalheNome"></h2>
                                <p class="text-muted mb-0">Cliente ativo na sua base de treinos.</p>
                            </div>
                        </div>
                        <div class="bg-light rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Idade</span>
                                <span class="badge bg-dark text-warning px-3 py-2" id="detalheIdade"></span>
                            </div>
                        </div>
                        <div class="mt-4 d-flex gap-3 flex-wrap">
                            <a class="btn btn-outline-dark" href="/clientes"><i class="bi bi-arrow-left me-2"></i>Voltar</a>
                            <a class="btn btn-gradient" href="/clientes/editar/@clienteId"><i class="bi bi-pencil-fill me-2"></i>Editar</a>
                            <a class="btn btn-outline-danger" href="/clientes/remover/@clienteId"><i class="bi bi-trash-fill me-2"></i>Remover</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const clienteId = '@clienteId';
        const mensagemErro = document.querySelector('#mensagemErro');
        const cardDetalhes = document.querySelector('#cardDetalhes');
        const detalheNome = document.querySelector('#detalheNome');
        const detalheIdade = document.querySelector('#detalheIdade');

        function exibirErro(erros) {
            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
            cardDetalhes.style.display = 'none';
        }

        async function carregarCliente() {
            try {
                const resposta = await fetch(`/api/cliente/buscarcliente/${clienteId}`);
                if (!resposta.ok) {
                    throw ['Não foi possível carregar o cliente.'];
                }
                const dados = await resposta.json();
                const cliente = dados.entidade ?? dados.Entidade;
                if (!cliente) {
                    throw ['Cliente não encontrado.'];
                }

                detalheNome.textContent = cliente.nome ?? cliente.Nome ?? '';
                detalheIdade.textContent = cliente.idade ?? cliente.Idade ?? '';
                mensagemErro.classList.add('d-none');
                cardDetalhes.style.display = 'block';
            } catch (erro) {
                exibirErro(erro);
            }
        }

        document.addEventListener('DOMContentLoaded', carregarCliente);
    </script>
}
