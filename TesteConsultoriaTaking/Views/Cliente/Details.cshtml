@{
    ViewData["Title"] = "Detalhes do Cliente";
    var clienteId = ViewData["ClienteId"]?.ToString();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div id="mensagemErro" class="alert alert-custom d-none"></div>
            <div class="form-card" id="cardDetalhes" style="display:none;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="mb-1">Ficha do cliente</h2>
                        <p class="text-muted mb-0">Visualize os dados essenciais antes de atualizar planos de treino.</p>
                    </div>
                    <span class="badge bg-dark">@clienteId</span>
                </div>
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-uppercase text-muted">Nome</dt>
                    <dd class="col-sm-8 fw-semibold" id="detalheNome"></dd>
                    <dt class="col-sm-4 text-uppercase text-muted">Idade</dt>
                    <dd class="col-sm-8" id="detalheIdade"></dd>
                </dl>
                <div class="d-grid gap-2 gap-md-3 d-md-flex justify-content-md-end">
                    <a class="btn btn-outline-light gradient-border" href="/clientes">Voltar</a>
                    <a class="btn btn-gradient" href="/clientes/editar/@clienteId"><i class="fa-solid fa-pen me-2"></i>Editar</a>
                    <a class="btn btn-outline-light gradient-border" href="/clientes/remover/@clienteId"><i class="fa-solid fa-trash me-2"></i>Remover</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const clienteId = '@clienteId';
        const mensagemErro = document.querySelector('#mensagemErro');
        const cardDetalhes = document.querySelector('#cardDetalhes');
        const detalheNome = document.querySelector('#detalheNome');
        const detalheIdade = document.querySelector('#detalheIdade');

        function exibirErro(erros) {
            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
            cardDetalhes.style.display = 'none';
        }

        async function carregarCliente() {
            try {
                const resposta = await fetch(`/api/cliente/buscarcliente/${clienteId}`);
                if (!resposta.ok) {
                    throw ['Não foi possível carregar o cliente.'];
                }
                const dados = await resposta.json();
                const cliente = dados.entidade ?? dados.Entidade;
                if (!cliente) {
                    throw ['Cliente não encontrado.'];
                }

                detalheNome.textContent = cliente.nome ?? cliente.Nome ?? '';
                detalheIdade.textContent = `${cliente.idade ?? cliente.Idade ?? ''} anos`;
                mensagemErro.classList.add('d-none');
                cardDetalhes.style.display = 'block';
            } catch (erro) {
                exibirErro(erro);
            }
        }

        document.addEventListener('DOMContentLoaded', carregarCliente);
    </script>
}
