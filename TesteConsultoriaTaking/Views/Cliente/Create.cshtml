@{
    ViewData["Title"] = "Novo Cliente";
}

<h1>Novo Cliente</h1>
<div class="card">
    <div class="card-body">
        <form id="formCriar">
            <div class="form-group">
                <label for="nome">Nome</label>
                <input id="nome" name="nome" class="form-control" maxlength="100" required />
            </div>
            <div class="form-group">
                <label for="idade">Idade</label>
                <input id="idade" name="idade" type="number" class="form-control" min="0" required />
            </div>
            <div id="mensagemErro" class="alert alert-danger d-none"></div>
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a href="/clientes" class="btn btn-secondary ml-2">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const formCriar = document.querySelector('#formCriar');
        const mensagemErro = document.querySelector('#mensagemErro');

        function exibirErro(erros) {
            if (!erros) {
                mensagemErro.classList.add('d-none');
                mensagemErro.textContent = '';
                return;
            }

            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
        }

        formCriar.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            exibirErro();

            const payload = {
                nome: formCriar.nome.value.trim(),
                idade: Number.parseInt(formCriar.idade.value, 10)
            };

            try {
                const resposta = await fetch('/api/cliente/adicionar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!resposta.ok) {
                    const conteudo = await resposta.json().catch(() => null);
                    const erros = conteudo?.listaErros ?? conteudo?.ListaErros ?? ['Não foi possível salvar o cliente.'];
                    throw erros;
                }

                window.location.href = '/clientes';
            } catch (erro) {
                exibirErro(erro);
            }
        });
    </script>
}
