@{
    ViewData["Title"] = "Novo Cliente";
}

<section class="py-5">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-elevated">
                    <div class="d-flex align-items-center mb-4">
                        <span class="gradient-icon me-3"><i class="bi bi-person-plus-fill"></i></span>
                        <div>
                            <h2 class="fw-bold mb-0">Cadastrar cliente</h2>
                            <p class="text-muted mb-0">Registre informações essenciais para personalizar o treino.</p>
                        </div>
                    </div>
                    <form id="formCriar" novalidate>
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome completo</label>
                            <input id="nome" name="nome" class="form-control" maxlength="100" placeholder="Ex.: Ana Souza" required />
                        </div>
                        <div class="mb-4">
                            <label for="idade" class="form-label">Idade</label>
                            <input id="idade" name="idade" type="number" class="form-control" min="0" placeholder="Ex.: 29" required />
                        </div>
                        <div id="mensagemErro" class="alert alert-danger d-none"></div>
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-gradient flex-grow-1">Salvar cliente</button>
                            <a href="/clientes" class="btn btn-outline-dark">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const formCriar = document.querySelector('#formCriar');
        const mensagemErro = document.querySelector('#mensagemErro');

        function exibirErro(erros) {
            if (!erros) {
                mensagemErro.classList.add('d-none');
                mensagemErro.textContent = '';
                return;
            }

            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
        }

        formCriar.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            exibirErro();

            const payload = {
                nome: formCriar.nome.value.trim(),
                idade: Number.parseInt(formCriar.idade.value, 10)
            };

            if (!payload.nome || Number.isNaN(payload.idade)) {
                exibirErro('Preencha todas as informações do cliente.');
                return;
            }

            try {
                const resposta = await fetch('/api/cliente/adicionar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!resposta.ok) {
                    const conteudo = await resposta.json().catch(() => null);
                    const erros = conteudo?.listaErros ?? conteudo?.ListaErros ?? ['Não foi possível salvar o cliente.'];
                    throw erros;
                }

                window.location.href = '/clientes';
            } catch (erro) {
                exibirErro(erro);
            }
        });
    </script>
}
