@{
    ViewData["Title"] = "Novo Cliente";
}

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7">
                <div class="text-center mb-4">
                    <span class="badge badge-soft text-uppercase mb-2"><i class="bi bi-person-plus-fill me-2"></i>Cadastro</span>
                    <h2 class="section-title mb-2">Adicionar novo cliente</h2>
                    <p class="section-subtitle">Preencha os dados para criar uma ficha de treino personalizada.</p>
                </div>
                <div class="form-surface">
                    <form id="formCriar" novalidate>
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome completo</label>
                            <input id="nome" name="nome" class="form-control" maxlength="100" required placeholder="Digite o nome" />
                        </div>
                        <div class="mb-4">
                            <label for="idade" class="form-label">Idade</label>
                            <input id="idade" name="idade" type="number" class="form-control" min="0" required placeholder="Ex.: 29" />
                        </div>
                        <div id="mensagemErro" class="alert alert-danger d-none"></div>
                        <div class="d-flex flex-wrap gap-2 justify-content-between">
                            <a href="/clientes" class="btn btn-outline-dark px-4"><i class="bi bi-arrow-left me-2"></i>Cancelar</a>
                            <button type="submit" class="btn btn-gradient px-4"><i class="bi bi-check-circle-fill me-2"></i>Salvar cliente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const formCriar = document.querySelector('#formCriar');
        const mensagemErro = document.querySelector('#mensagemErro');

        function exibirErro(erros) {
            if (!erros) {
                mensagemErro.classList.add('d-none');
                mensagemErro.textContent = '';
                return;
            }

            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
        }

        formCriar.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            exibirErro();

            const payload = {
                nome: formCriar.nome.value.trim(),
                idade: Number.parseInt(formCriar.idade.value, 10)
            };

            try {
                const resposta = await fetch('/api/cliente/adicionar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!resposta.ok) {
                    const conteudo = await resposta.json().catch(() => null);
                    const erros = conteudo?.listaErros ?? conteudo?.ListaErros ?? ['Não foi possível salvar o cliente.'];
                    throw erros;
                }

                window.location.href = '/clientes';
            } catch (erro) {
                exibirErro(erro);
            }
        });
    </script>
}
