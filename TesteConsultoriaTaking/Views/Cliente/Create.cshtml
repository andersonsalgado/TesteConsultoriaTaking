@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="mb-1">Cadastrar cliente</h2>
                        <p class="text-muted mb-0">Organize o cadastro para liberar treinos personalizados imediatamente.</p>
                    </div>
                    <span class="badge bg-dark">Novo aluno</span>
                </div>
                <form id="formCriar">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome completo</label>
                        <input id="nome" name="nome" class="form-control" maxlength="180" required placeholder="Nome do cliente" />
                    </div>
                    <div class="mb-3">
                        <label for="idade" class="form-label">Idade</label>
                        <input id="idade" name="idade" type="number" class="form-control" min="0" max="120" required placeholder="Idade" />
                    </div>
                    <div id="mensagemErro" class="alert alert-custom d-none"></div>
                    <div class="d-grid gap-2 gap-md-3 d-md-flex justify-content-md-end">
                        <a href="/clientes" class="btn btn-outline-light gradient-border">Cancelar</a>
                        <button type="submit" class="btn btn-gradient">Salvar cliente</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const formCriar = document.querySelector('#formCriar');
        const mensagemErro = document.querySelector('#mensagemErro');

        function exibirErro(erros) {
            if (!erros) {
                mensagemErro.classList.add('d-none');
                mensagemErro.innerHTML = '';
                return;
            }

            const lista = Array.isArray(erros) ? erros : [erros];
            mensagemErro.innerHTML = lista.map(e => `<div>${e}</div>`).join('');
            mensagemErro.classList.remove('d-none');
        }

        formCriar.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            exibirErro();

            const payload = {
                nome: formCriar.nome.value.trim(),
                idade: Number.parseInt(formCriar.idade.value, 10)
            };

            try {
                const resposta = await fetch('/api/cliente/adicionar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!resposta.ok) {
                    const conteudo = await resposta.json().catch(() => null);
                    const erros = conteudo?.listaErros ?? conteudo?.ListaErros ?? ['Não foi possível salvar o cliente.'];
                    throw erros;
                }

                window.location.href = '/clientes';
            } catch (erro) {
                exibirErro(erro);
            }
        });
    </script>
}
