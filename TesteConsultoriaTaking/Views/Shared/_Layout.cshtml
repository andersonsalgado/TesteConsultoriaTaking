@using TesteConsultoriaTaking.Models
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Taking Fitness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-GtvUhtO/zG8VCzshI0Pbi38Gj6E2R8iz6NbyN1Nsx3Rp3XIan+FJxux1DPZWS9y5" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" integrity="sha384-Vv0wH14R/2uOeGZ5ER5YjZL+QkNo4fU6Y4ZCkxzgv2Fne5+5ZTCDJ/NzVzfuNs8y" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="top-navbar shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark py-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center" href="@Url.Action("Index", "Home")">
                    <span class="logo-circle me-2"><i class="bi bi-lightning-charge-fill"></i></span>
                    Taking Fitness
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/#home")"><i class="bi bi-house-door-fill me-2"></i>Home</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Content("~/#funcionalidades")"><i class="bi bi-grid-1x2-fill me-2"></i>Funcionalidades</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/#preco")"><i class="bi bi-cash-stack me-2"></i>Preço</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/#relatos")"><i class="bi bi-chat-dots-fill me-2"></i>Relatos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/#faq")"><i class="bi bi-question-circle-fill me-2"></i>Perguntas frequentes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/#contato")"><i class="bi bi-envelope-fill me-2"></i>Fale Conosco</a>
                        </li>
                        <li class="nav-item">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <form class="d-flex" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                    <button type="submit" class="btn btn-gradient ms-lg-2"><i class="bi bi-box-arrow-right me-2"></i>Sair</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-gradient ms-lg-2" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-person-circle me-2"></i>Login</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-gradient text-center text-white py-4 mt-5">
        <div class="container">
            <p class="mb-1 fw-semibold">Transforme seu corpo. Transforme sua mente.</p>
            <small>&copy; @DateTime.Now.Year Taking Fitness • Treinos inteligentes e personalizáveis.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-GtvUhtO/zG8VCzshI0Pbi38Gj6E2R8iz6NbyN1Nsx3Rp3XIan+FJxux1DPZWS9y5" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
