@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FitMaster</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" integrity="sha512-iz+Gv7Z7g+nW3ES9FNMkvFEWaP7LZEdy77D8+92dQy5E1vDLteA94ppIqh+apMI2vlA38nSxrdbidKdvUSs7xg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="main-header shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark container py-3">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">
                <span class="logo-highlight">Fit</span>Master
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/"> <i class="fa-solid fa-house me-1"></i> Home</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/clientes"> <i class="fa-solid fa-dumbbell me-1"></i> Funcionalidades</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/#precos"> <i class="fa-solid fa-tags me-1"></i> Preço</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#relatos"> <i class="fa-solid fa-users me-1"></i> Relatos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#faq"> <i class="fa-solid fa-circle-question me-1"></i> Perguntas frequentes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#contato"> <i class="fa-solid fa-comments me-1"></i> Fale Conosco</a>
                    </li>
                    <li class="nav-item ms-lg-3">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light gradient-border" type="submit">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Sair
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-gradient" href="@Url.Action("Login", "Account")">
                                <i class="fa-solid fa-user me-2"></i> Entrar
                            </a>
                        }
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <main class="flex-shrink-0">
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>
    <footer class="py-4 text-center text-white footer-gradient">
        <div class="container">
            <p class="mb-1">&copy; @DateTime.Now.Year - FitMaster Treinos Personalizados</p>
            <p class="small mb-0">Transformando sua jornada fitness com tecnologia e disciplina.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
