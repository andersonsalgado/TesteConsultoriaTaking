@using Microsoft.AspNetCore.Identity
@using TesteConsultoriaTaking.Models
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TreinoX</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark py-3" id="mainNavbar">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand fw-bold d-flex align-items-center" href="@Url.Action("Index", "Home")">
                    <span class="gradient-icon me-2"><i class="bi bi-lightning-charge-fill"></i></span>
                    TreinoX
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#home"><i class="bi bi-house-door-fill me-2"></i>Home</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-grid-1x2-fill me-2"></i>Funcionalidades
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="featuresDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#funcionalidades"><i class="bi bi-lightning-fill me-2"></i>Ver destaques</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/clientes"><i class="bi bi-people-fill me-2"></i>Cadastro de Clientes</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#pricing"><i class="bi bi-currency-dollar me-2"></i>Preço</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#testimonials"><i class="bi bi-chat-square-heart-fill me-2"></i>Relatos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#faq"><i class="bi bi-question-circle-fill me-2"></i>Perguntas frequentes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#contact"><i class="bi bi-envelope-fill me-2"></i>Fale Conosco</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-gradient btn-sm px-4"><i class="bi bi-box-arrow-right me-2"></i>Sair</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-gradient btn-sm px-4" href="@Url.Action("Login", "Account")"><i class="bi bi-box-arrow-in-right me-2"></i>Login</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-fill">
        @RenderBody()
    </main>

    <footer class="mt-auto py-4 text-center text-white footer-gradient">
        <div class="container">
            <p class="mb-0 small">&copy; @DateTime.Now.Year TreinoX - Performance personalizada para todos os níveis.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
